# =============================================================================
# ROS — Restaurant Operating System — Environment Variables
# Copy this file to .env and fill in all values before running
# =============================================================================

# ── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Database (PostgreSQL with PgBouncer Connection Pooler) ────────────────────
# Application Pooled Connection (PgBouncer port 6432 - Transaction pooling):
DATABASE_URL="postgresql://ros_user:ros_pass@localhost:6432/ros_db?schema=public&pgbouncer=true&connection_limit=20"
# Direct PostgreSQL Connection (port 5432) for Prisma migrations & DDL schema pushes:
DIRECT_URL="postgresql://ros_user:ros_pass@localhost:5432/ros_db?schema=public"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET="CHANGE_ME_LONG_RANDOM_SECRET_FOR_ACCESS_TOKEN"
JWT_REFRESH_SECRET="CHANGE_ME_LONG_RANDOM_SECRET_FOR_REFRESH_TOKEN"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=4000
API_URL="http://localhost:4000"
CORS_ORIGIN="http://localhost:3000"

# ── Web App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_WS_URL="http://localhost:4000"

# ── S3 / Object Storage ───────────────────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="ros-uploads"
S3_REGION="us-east-1"

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@yourrestaurant.com"

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ── Bcrypt ────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
